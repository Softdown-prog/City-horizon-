  "designIntent": {
    "summary": "Colorful neighborhood ice cream shop with a framed pastel storefront, oversized flavor display, large sundae mark and a slowly rotating corner popsicle totem.",
    "readOrder": ["corner_popsicle", "sundae_sign", "striped_awning", "flavor_display", "framed_storefront", "pastel_wall_mass", "roofline"],
    "rules": [
      "keep the silhouette compact and readable at gameplay scale",
      "do not depend on readable text for ice-cream identity",
      "use broad pastel color blocks rather than tiny decorative noise",
      "make the storefront read as designed architecture through a crown, vertical color rhythm and stronger freezer display",
      "keep the animation slow and localized to the corner popsicle totem so the building does not visually jitter",
      "keep the roof visually subordinate to the storefront by using a lower parapet",
      "author all four sides because AssetRoot rotation produces canonical directions",
      "keep the front apron visually flush for future road/sidewalk placement",
      "CH_COLOR_MASK_V1 recolors only wall in R and roof in G; awning, flavor colors, glass, trim and animated sign keep authored colors"
    ]
  }
