{
  "contract": "CH_SHAPE_AUTHORING_V1",
  "status": "active",
  "authority": "City Horizon silhouette-first deterministic Blender authoring",
  "purpose": "Make authored 3D forms predictable before proxy review by standardizing reusable silhouette primitives and machine-readable shape diagnostics.",
  "units": {
    "space": "Blender world space",
    "metricScene": true,
    "blenderUnitsPerTile": 3.0
  },
  "primitiveFamilies": [
    "symmetric_section_loft",
    "open_tub_loft",
    "profile_prism",
    "mirrored_profile_pair",
    "rounded_box"
  ],
  "rules": {
    "deterministic": true,
    "randomSeedAllowed": false,
    "sectionOrder": "strictly increasing Y",
    "symmetricLoftMirrorAxis": "X=0",
    "openTub": {
      "topMustRemainOpen": true,
      "innerHalfWidthMustBeLessThanOuterHalfWidth": true,
      "innerFloorMustRemainAboveOuterBottom": true,
      "rimMustRemainAboveInnerFloor": true,
      "purpose": "Integrated hollow bodies such as coaster cars, boats, gondolas and other open vehicles without detached side-wall masses."
    },
    "semanticRoleRequired": true,
    "bevelSegments": 2,
    "preferSingleIntegratedSilhouette": true,
    "avoidDetachedDecorativeMassesWhenOneLoftCanRepresentTheBody": true
  },
  "diagnostics": {
    "contract": "CH_SHAPE_REPORT_V1",
    "requiredMetrics": [
      "bounds",
      "dimensions",
      "centerOffsetX",
      "xSymmetryError",
      "projectedSouthBounds",
      "projectedSouthOccupancy",
      "semanticRoleBounds",
      "shapePrimitiveCounts"
    ],
    "supportedConstraints": [
      "maxXSymmetryError",
      "maxAbsCenterOffsetX",
      "minProjectedSouthOccupancy",
      "maxProjectedSouthOccupancy",
      "requiredPrimitiveMinimums"
    ],
    "purpose": "Reject gross silhouette, alignment and authoring-regression mistakes before expensive final bake. Asset-specific expected ranges belong in the builder, not this global contract."
  },
  "runtime": {
    "dependency": false,
    "representation": "pre-rendered 2D RGBA"
  }
}
