{
  "id": "classic_visual_reference_gate_1",
  "name": "City Horizon Classic Tycoon Visual Reference Gate",
  "status": "official_reference_profile",
  "productionAuthority": false,
  "purpose": "Provide one deterministic classic-tycoon reference building and reproducible QA package for comparison, calibration and optional retro profiles. This contract is no longer the global production visual authority; CH_STYLIZED_PRERENDER_V1 defines the default production baseline.",
  "referenceBuildingId": "classic_tycoon_reference_house_1",
  "referenceSpec": {
    "footprint": [2, 2],
    "floors": 2,
    "floorHeightPx": 64,
    "roofProfile": "hip",
    "wallMaterial": "plaster",
    "roofMaterial": "ceramic_tile",
    "materialSeed": 17,
    "neighborhoodSeed": 401
  },
  "requiredVisualContractsForThisReferenceProfile": [
    "structured_directional_materials_1",
    "classic_three_tone_ramp_1",
    "localized_contact_ao_1",
    "fixed_world_cast_shadow_1",
    "building_lod_gate_1",
    "small_block_preview_1"
  ],
  "requiredArtifacts": [
    "building_composer_visual_reference_hero.png",
    "building_composer_visual_reference_materials.png",
    "building_composer_visual_reference_shadow.png",
    "building_composer_visual_reference_lod.png",
    "building_composer_visual_reference_block.png",
    "building_composer_visual_reference_report.json"
  ],
  "materialBoard": {
    "sameGeometry": true,
    "samePalette": true,
    "sameLighting": true,
    "changesOnlyWallRecipe": true,
    "recipes": ["plaster", "brick", "concrete", "timber", "stone", "metal_panel", "glass"],
    "passRules": [
      "material identity is structural rather than salt-and-pepper noise",
      "pattern direction follows the isometric surface",
      "detail remains readable at normal gameplay scale",
      "high frequency repetition must not become moire"
    ]
  },
  "lightingAndAoGate": {
    "appliesToThisClassicReferenceProfileOnly": true,
    "threeToneWorldLightingRequired": true,
    "requiredLevels": ["light", "mid", "shadow"],
    "continuousWallGradientForbidden": true,
    "globalProductionRule": false,
    "aoContract": "localized_contact_ao_1",
    "passRules": [
      "face separation is clear without appearing vector-flat",
      "eave AO stays short",
      "corner AO reads as contact rather than a painted stripe",
      "opening recess AO stays local",
      "wall-ground AO does not become a second base course"
    ]
  },
  "shadowGate": {
    "contract": "fixed_world_cast_shadow_1",
    "comparison": ["south_off", "south_on", "east_off", "east_on"],
    "passRules": [
      "shadow visibly grounds the mass",
      "world light direction remains camera independent",
      "shadow is cool charcoal rather than pure black",
      "penumbra is restrained",
      "shadow remains inside validated frame"
    ]
  },
  "lodGate": {
    "contract": "building_lod_gate_1",
    "scales": [0.35, 0.60, 1.00],
    "mustPassAutomatedLodValidation": true
  },
  "blockGate": {
    "contract": "small_block_preview_1",
    "neighborhoodSeed": 401,
    "passRules": [
      "silhouette remains readable among neighbours",
      "reference building does not disappear into repeated roof or wall patterns",
      "street grounding remains convincing",
      "detail density remains compatible with gameplay scale"
    ]
  },
  "manualFinalChecklist": [
    "silhouette reads before microdetail",
    "materials remain readable at gameplay scale",
    "ambient occlusion is localized to real contacts",
    "cast shadow grounds the building without becoming a black blob",
    "all three LODs remain legible",
    "small-block context remains coherent",
    "no halo clipping or accidental terrain is baked into transparent production sprites"
  ],
  "policy": {
    "defaultProductionVisualContract": "CH_STYLIZED_PRERENDER_V1",
    "strictRetroSimilarityIsOptional": true,
    "referenceSpecIsFrozenUntilIntentionalVisualRevision": true,
    "newRendererRevisionMustRegenerateAllArtifactsWhenThisProfileIsUsed": true,
    "visualBaselineChangeRequiresPresetRevision": true,
    "qaArtifactsDoNotReplaceProductionExportValidation": true,
    "noProprietaryTycoonAssetsAreCopied": true
  }
}
