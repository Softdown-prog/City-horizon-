{
  "id": "animation_core_5",
  "name": "City Horizon Animation Core",
  "status": "canonical",
  "purpose": "Deterministic parametric timeline, hierarchical part animation, reusable visual libraries, dynamic draw order, visual variants and frame export contract for animated City Horizon assets.",
  "dataModel": {
    "asset": "AnimatedAssetSpec",
    "node": "AnimationNodeSpec",
    "clip": "AnimationClip",
    "track": "AnimationTrack",
    "keyframe": "AnimationKeyframe",
    "frameNodeState": "AnimationNodeState"
  },
  "timing": {
    "frameCountRange": [2, 240],
    "timeUnit": "seconds",
    "loopClipsOmitDuplicatedEndFrame": true,
    "loopTracksRequireStartAndDurationKeys": true,
    "loopEndpointsMustMatch": true,
    "fullTurnRotationEndpointsEquivalent": true
  },
  "interpolation": ["step", "linear", "smooth_step", "sine"],
  "trackProperties": [
    "offset_x_px",
    "offset_y_px",
    "rotation_degrees",
    "scale",
    "opacity",
    "visibility",
    "draw_order",
    "visual_variant"
  ],
  "hierarchy": {
    "version": "animation_node_hierarchy_2",
    "contractFile": "animation_node_hierarchy_contract.json",
    "implicitRoot": "root",
    "uniqueNodeIds": true,
    "acyclic": true,
    "parentMustExist": true,
    "trackTargetMustExist": true,
    "duplicateTargetPropertyTracksRejected": true,
    "childTransformsComposeWithParent": true,
    "drawOrderMayAnimate": true,
    "visualVariantMayAnimate": true,
    "nodeStateRecordedPerFrame": true
  },
  "visualSources": {
    "version": "animation_visual_sources_3",
    "contractFile": "animation_visual_sources_contract.json",
    "supportedKinds": ["none", "primitive_rectangle", "primitive_ellipse", "raster_sprite", "building_render", "library_part"],
    "productionPreferredKinds": ["raster_sprite", "building_render", "library_part"],
    "registeredLibraries": ["carousel_parts_2"],
    "relativeRasterRoot": "AnimatedAssetSpec.visual_source_root",
    "transparentTrim": true,
    "preserveAspect": true,
    "sourceValidationBeforeExport": true,
    "perFrameVisualVariantResolution": true
  },
  "coherence": {
    "stableNormalizedAnchor": true,
    "stableFrameSize": true,
    "stableBaseRenderable": true,
    "stablePaletteProfile": true,
    "stableNodePivots": true,
    "stableNodeVisualSources": true,
    "deterministicSampling": true,
    "frameIndependentRandomGeneration": false
  },
  "preview": {
    "singleFrame": true,
    "contactSheet": true,
    "spritesheet": true,
    "frameLabelsIncludeTime": true,
    "dynamicDrawOrder": true,
    "visualVariants": true,
    "missingSourceDiagnosticMarker": true,
    "canonicalCarouselLibraryQa": true
  },
  "export": {
    "version": "animation_export_4",
    "outputs": ["spritesheet_png", "preview_png", "manifest_json"],
    "spritesheetOrder": "row_major",
    "manifestRecordsFrameSamples": true,
    "manifestRecordsNodeStates": true,
    "manifestRecordsDynamicDrawOrder": true,
    "manifestRecordsVisualVariant": true,
    "manifestRecordsNodeVisualSources": true,
    "manifestRecordsLibraryPartIds": true,
    "manifestRecordsAnchor": true,
    "manifestRecordsPaletteProfile": true,
    "visualSourcesValidatedBeforeBake": true,
    "runtime": "SDL consumes baked frame cells and clip timing; hierarchy, resolved draw order and visual variants remain authoring/debug metadata"
  },
  "scope": {
    "currentRenderable": "BuildingComposerSpec plus persistent hierarchical nodes with raster_sprite, building_render or registered library_part visuals",
    "currentTrackTargets": ["root", "authored_node_id"],
    "activeLibraries": ["carousel_parts_2"],
    "activeMechanicalAuthoring": ["carousel_composer_2"],
    "nextSystems": ["palette_profiles", "rig_joints", "animal_parts", "effects", "runtime_carousel_integration"]
  },
  "authoringRule": "Frames are samples of one canonical asset and one timeline. Persistent nodes keep stable identity, pivots and source IDs while authored tracks may change transforms, visibility, draw order and visual variant deterministically. Dynamic depth never creates replacement nodes or independent per-frame artwork."
}
