{
  "id": "carousel_composer_2",
  "name": "City Horizon Carousel Composer",
  "status": "canonical",
  "purpose": "Parametric authoring layer that assembles a complete animated carousel with dynamic isometric depth ordering and directional horse presentation from stable City Horizon library parts.",
  "dependsOn": {
    "animationCore": "animation_core_5",
    "visualSources": "animation_visual_sources_3",
    "partLibrary": "carousel_parts_2"
  },
  "spec": "CarouselComposerSpec",
  "parameters": {
    "horseCount": {"min": 2, "max": 24, "default": 8},
    "platformRadiusPx": {"min": 32.0, "max": 110.0, "default": 72.0},
    "isometricDepthScale": {"min": 0.25, "max": 0.70, "default": 0.46},
    "horseBobAmplitudePx": {"min": 0.0, "max": 24.0, "default": 9.0},
    "durationSeconds": {"min": 0.50, "max": 20.0, "default": 2.4},
    "frameCount": {"min": 4, "max": 120, "default": 16},
    "clockwise": {"default": true},
    "dynamicDepthOrdering": {"default": true},
    "directionalHorses": {"default": true},
    "canopyEnabled": {"default": true},
    "rosettesEnabled": {"default": true},
    "finialEnabled": {"default": true},
    "rosetteCount": {"min": 0, "max": 16, "default": 6}
  },
  "paletteProfiles": [
    "carousel_classic_red_cream",
    "carousel_blue_gold",
    "carousel_green_ivory"
  ],
  "generatedHierarchy": {
    "base": "root",
    "platform": "root",
    "horses": "platform",
    "centerPole": "root",
    "canopy": "root",
    "rosettes": "canopy",
    "finial": "canopy"
  },
  "automaticAuthoring": {
    "horseIdsStable": true,
    "horseAngularDistribution": "uniform",
    "horseScreenDepthDistribution": "isometric_ellipse",
    "horseBobPhases": "uniform_around_cycle",
    "platformRotationTrack": true,
    "horseBobTracks": true,
    "horseCounterRotationTracks": true,
    "horseVisualVariantTracks": true,
    "horseDynamicDrawOrderTracks": true,
    "directionalVariants": ["east", "south", "west", "north"],
    "depthLayers": {"backHorse": 20, "centerPole": 60, "frontHorse": 65, "canopy": 90},
    "loopClosure": true,
    "libraryPartAssembly": true,
    "deterministic": true
  },
  "outputs": {
    "animatedAssetSpec": true,
    "animationSpritesheet": "through_animation_export_4",
    "animationRuntimeManifest": "through_animation_export_4",
    "animationPreview": "through_AnimationPreviewRenderer",
    "authoringManifest": "CarouselComposer.manifest"
  },
  "qaReference": {
    "horseCount": 8,
    "frameCount": 16,
    "durationSeconds": 2.4,
    "platformRadiusPx": 72.0,
    "palette": "carousel_classic_red_cream",
    "dynamicDepthOrdering": true,
    "directionalHorses": true,
    "manualNodeAuthoringRequired": false,
    "manualTrackAuthoringRequired": false
  },
  "resolvedLimitations": {
    "dynamicPerFrameDepthSorting": true,
    "directionalHorseViewSwapping": true,
    "counterRotationKeepsHorseSpriteUpright": true
  },
  "authoringRule": "Carousel authors set ride-level parameters only. The Composer owns generated node IDs, hierarchy, angular placement, loop-safe platform rotation, per-horse bob phases, front/back depth transitions, counter-rotation and directional visual variants. The generated AnimatedAssetSpec remains the sole input to preview and runtime frame export."
}
