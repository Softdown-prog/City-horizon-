{
  "id": "architectural_modules_2",
  "name": "City Horizon Architectural Module Library",
  "status": "official",
  "purpose": "Stable reusable architectural component recipes shared by Building Composer buildings.",
  "rules": {
    "stableIds": true,
    "deterministic": true,
    "socketDrivenPlacement": true,
    "copyPerBuildingRecipes": false,
    "supportsAnyLogicalFacade": true,
    "supportsFloorIndex": true,
    "visualPreset": "city_horizon_classic_tycoon"
  },
  "modules": [
    {
      "id": "window.classic_framed.v1",
      "kind": "window",
      "surface": "wall",
      "placement": "facade_floor_socket",
      "rendererRecipe": "BuildingFacadeRenderer::drawModule",
      "features": ["frame", "glass", "center_mullion", "floor_aware"]
    },
    {
      "id": "door.classic_wood.v1",
      "kind": "door",
      "surface": "wall",
      "placement": "facade_floor_socket",
      "rendererRecipe": "BuildingFacadeRenderer::drawModule",
      "features": ["frame", "wood_leaf", "ground_or_upper_floor_authoring"]
    },
    {
      "id": "storefront.classic_glass.v1",
      "kind": "storefront",
      "surface": "wall",
      "placement": "facade_floor_socket",
      "rendererRecipe": "BuildingFacadeRenderer::drawModule",
      "features": ["wide_glazing", "center_mullion", "commercial_ground_floor"]
    },
    {
      "id": "sign.facade_plaque.v1",
