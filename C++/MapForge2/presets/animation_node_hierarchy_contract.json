{
  "id": "animation_node_hierarchy_1",
  "name": "City Horizon Animation Node Hierarchy",
  "status": "canonical",
  "purpose": "Persistent part/node hierarchy for coherent multi-part animation such as carousels, ferris wheels, characters and animals.",
  "root": {
    "id": "root",
    "implicit": true,
    "reserved": true,
    "ownsAssetAnchor": true
  },
  "node": {
    "type": "AnimationNodeSpec",
    "required": ["id", "parentId"],
    "transform": ["positionPx", "pivotNormalized", "rotationDegrees", "scale", "opacity", "visible"],
    "drawOrder": true,
    "visualSourceContract": "animation_visual_sources_1",
    "visualSourceKinds": ["none", "primitive_rectangle", "primitive_ellipse", "raster_sprite", "building_render"]
  },
  "validation": {
    "uniqueIds": true,
    "rootIdCannotBeReused": true,
    "parentMustExist": true,
    "selfParentRejected": true,
    "cyclesRejected": true,
    "pivotRange": [0.0, 1.0],
    "positiveScale": true,
    "opacityRange": [0.0, 1.0],
    "trackTargetsMustExist": true,
    "duplicateTargetPropertyTracksRejected": true,
    "productionVisualSourcesValidatedBeforeExport": true
  },
  "composition": {
    "parentTransformPropagatesToChildren": true,
    "childKeepsIndependentTrackState": true,
    "visibilityIsCumulative": true,
    "opacityIsCumulative": true,
    "drawOrderIsDeterministic": true,
    "assetRootTransformAppliesBeforeNodeHierarchy": true,
    "visualSourceResolvedBeforeHierarchicalTransform": true
  },
  "qaReference": {
    "baseStatic": true,
    "platformRotates": true,
    "horsesParentedToPlatform": true,
    "horsesUseIndependentVerticalTracks": true,
    "structuralPartsUseBuildingRenderSources": true,
    "movingPartStandInsUseRealRasterSprite": true,
    "frameCount": 12,
    "durationSeconds": 2.0,
    "loop": true
  },
  "export": {
    "nodeDefinitionsInManifest": true,
    "visualSourceDefinitionsInManifest": true,
    "resolvedNodeStateRecordedPerFrame": true,
    "bakedFramesRemainPrimaryRuntimePayload": true
  },
  "futureCompatibility": {
    "carouselPartLibrary": true,
    "mechanicalSubassemblies": true,
    "characterRigJoints": true,
    "animalRigJoints": true,
    "counterRotationTracks": true
  },
  "authoringRule": "A moving part is one persistent node with one stable visual source across the entire clip. Never create a visually similar replacement node for each frame. Parent/child relationships, pivots, palette identity, visual source and draw order remain stable; only authored track properties change over time."
}
