{
  "id": "animation_node_hierarchy_2",
  "name": "City Horizon Animation Node Hierarchy",
  "status": "canonical",
  "purpose": "Persistent part/node hierarchy for coherent multi-part animation with deterministic per-frame draw ordering and visual presentation state.",
  "root": {
    "id": "root",
    "implicit": true,
    "reserved": true,
    "ownsAssetAnchor": true
  },
  "node": {
    "type": "AnimationNodeSpec",
    "required": ["id", "parentId"],
    "transform": ["positionPx", "pivotNormalized", "rotationDegrees", "scale", "opacity", "visible"],
    "drawOrder": "authored_default_plus_optional_track",
    "visualVariant": "authored_default_plus_optional_track",
    "visualSourceContract": "animation_visual_sources_3",
    "visualSourceKinds": ["none", "primitive_rectangle", "primitive_ellipse", "raster_sprite", "building_render", "library_part"]
  },
  "validation": {
    "uniqueIds": true,
    "rootIdCannotBeReused": true,
    "parentMustExist": true,
    "selfParentRejected": true,
    "cyclesRejected": true,
    "pivotRange": [0.0, 1.0],
    "positiveScale": true,
    "opacityRange": [0.0, 1.0],
    "visualVariantNonNegative": true,
    "trackTargetsMustExist": true,
    "duplicateTargetPropertyTracksRejected": true,
    "nodeOnlyDrawOrderRejectedOnRoot": true,
    "nodeOnlyVisualVariantRejectedOnRoot": true,
    "productionVisualSourcesValidatedBeforeExport": true
  },
  "composition": {
    "parentTransformPropagatesToChildren": true,
    "childKeepsIndependentTrackState": true,
    "visibilityIsCumulative": true,
    "opacityIsCumulative": true,
    "drawOrderIsDeterministicPerFrame": true,
    "drawOrderMayChangeAcrossFrames": true,
    "visualVariantMayChangeAcrossFrames": true,
    "assetRootTransformAppliesBeforeNodeHierarchy": true,
    "visualSourceResolvedBeforeHierarchicalTransform": true
  },
  "qaReference": {
    "platformRotates": true,
    "horsesParentedToPlatform": true,
    "horsesUseIndependentVerticalTracks": true,
    "horsesUseCounterRotation": true,
    "horsesChangeDirectionalVariant": true,
    "horsesMoveBehindAndInFrontOfCenterPole": true,
    "frameCount": 16,
    "durationSeconds": 2.4,
    "loop": true
  },
  "export": {
    "nodeDefinitionsInManifest": true,
    "visualSourceDefinitionsInManifest": true,
    "resolvedNodeStateRecordedPerFrame": true,
    "resolvedDrawOrderRecordedPerFrame": true,
    "resolvedVisualVariantRecordedPerFrame": true,
    "bakedFramesRemainPrimaryRuntimePayload": true
  },
  "futureCompatibility": {
    "carouselPartLibrary": true,
    "mechanicalSubassemblies": true,
    "characterRigJoints": true,
    "animalRigJoints": true,
    "counterRotationTracks": true,
    "dynamicOcclusionLayers": true
  },
  "authoringRule": "A moving part is one persistent node with one stable source identity across the clip. Parent/child relationships and pivots remain stable; authored tracks may change transforms, visibility, draw order and visual variant to represent motion and occlusion without creating replacement artwork per frame."
}
