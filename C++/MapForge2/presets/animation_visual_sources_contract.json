{
  "id": "animation_visual_sources_3",
  "name": "City Horizon Animation Visual Sources",
  "status": "canonical",
  "purpose": "Allow each persistent animation node to render a stable authored visual source with deterministic per-frame presentation variants instead of regenerating independent artwork.",
  "supportedKinds": [
    "none",
    "primitive_rectangle",
    "primitive_ellipse",
    "raster_sprite",
    "building_render",
    "library_part"
  ],
  "productionPreferredKinds": ["raster_sprite", "building_render", "library_part"],
  "primitivePolicy": {
    "supportedForQaAndFallback": true,
    "recommendedForFinalArt": false
  },
  "rasterSprite": {
    "pathEncoding": "utf_8",
    "relativePathBase": "AnimatedAssetSpec.visual_source_root",
    "authoringResolverAlsoChecksExecutableParents": true,
    "optionalSourceRectPx": true,
    "transparentTrimSupported": true,
    "preserveAspectSupported": true,
    "smoothScalingSupported": true,
    "sourceMustResolveBeforeProductionExport": true
  },
  "buildingRender": {
    "source": "independent_BuildingComposerSpec",
    "viewStoredPerNode": true,
    "transparentTrimSupported": true,
    "preserveAspectSupported": true,
    "inheritsAnimationTimeline": false,
    "renderedAsStableNodeVisual": true
  },
  "libraryPart": {
    "stableIdRequired": true,
    "registeredNamespaceRequired": true,
    "firstRegisteredLibrary": "carousel_parts_2",
    "firstNamespace": "carousel.*",
    "deterministicRenderer": true,
    "transparentRgba": true,
    "perNodePrimaryColorSupported": true,
    "perNodeOutlineColorSupported": true,
    "visualVariantSupported": true,
    "variantIndexStoredInNodeState": true,
    "sourceMustResolveBeforeProductionExport": true
  },
  "coherence": {
    "nodeVisualSourceStableAcrossClip": true,
    "nodePivotStableAcrossClip": true,
    "visualSourceNotRegeneratedFromRandomPromptPerFrame": true,
    "sameNodeSourceIdentityUsedForEveryFrame": true,
    "presentationVariantMayChangePerFrame": true,
    "hierarchicalTransformsAppliedAfterSourceResolution": true
  },
  "export": {
    "version": "animation_export_4",
    "visualSourcesValidatedBeforeBake": true,
    "manifestRecordsVisualKind": true,
    "manifestRecordsVisualVariant": true,
    "manifestRecordsRasterPathWhenUsed": true,
    "manifestRecordsBuildingRenderIdentityWhenUsed": true,
    "manifestRecordsLibraryPartIdWhenUsed": true,
    "runtimeReceivesBakedFrames": true
  },
  "authoringRule": "A node owns one stable visual source identity for the clip. Motion and presentation come from deterministic timeline tracks and parent transforms; a visual variant may select an authored directional presentation of that same source without replacing the node or changing its pivot identity."
}
