{
  "id": "TYCOON_ASSET_BAKE_V1",
  "status": "golden_static_asset_approved",
  "purpose": "Bake declarative source assets through a frozen Blender studio into coherent four-direction 2D game sprites for City Horizon.",
  "sourceContract": "TYCOON_ASSET_SOURCE_V1",
  "studioPreset": "CH_TYCOON_STUDIO_V1",
  "dependsOn": {
    "camera": "CH_CAMERA_V1",
    "grid": "CH_GRID_V1",
    "visualStyle": "CH_STYLIZED_PRERENDER_V1",
    "legacyClassicReference": "CH_CLASSIC_TYCOON_STYLE_V1",
    "existingBuildingExport": "automatic_export_validation_7"
  },
  "renderer": {
    "backend": "Blender",
    "version": "4.2.3 LTS",
    "engine": "Cycles",
    "device": "CPU",
    "headless": true,
    "sourceResolution": [1024, 1024],
    "finalFrameResolution": [256, 256]
  },
  "camera": {
    "contract": "CH_CAMERA_V1",
    "projection": "orthographic_dimetric_2_to_1",
    "yawDegrees": 45.0,
    "elevationDegrees": 30.0,
    "cameraRotatesPerDirection": false
  },
  "rotationPolicy": {
    "assetRootRotates": true,
    "lightsRemainWorldFixed": true,
    "directionOrder": ["south", "east", "west", "north"],
    "directions": [
      {"id": "south", "quarterTurns": 0, "rotationDegrees": 0},
      {"id": "east", "quarterTurns": 1, "rotationDegrees": 90},
      {"id": "west", "quarterTurns": 3, "rotationDegrees": 270},
      {"id": "north", "quarterTurns": 2, "rotationDegrees": 180}
    ],
    "source": "BuildingComposer quarterTurns + BuildingExportPipeline kViews"
  },
  "visualPolicy": {
    "contract": "CH_STYLIZED_PRERENDER_V1",
    "productionDefault": "stylized_prerendered_tycoon",
    "strictRetroEmulation": false,
    "classicTycoonInfluence": true,
    "priority": "scalable_consistent_pre_rendered_assets",
    "retroProfilesAreOptional": true,
    "manualPixelCleanupIsNotNormalProductionWorkflow": true
  },
  "postProcess": {
    "variantsRetainedForReview": 4,
    "candidateVariant": 1,
    "defaultProductionTreatment": "full_color_or_light_stylization",
    "paletteReductionRequired": false,
    "ditherRequired": false,
    "paletteColorsForOptionalReviewVariant": 128,
    "edgeCleanup": "subtle_if_needed",
    "assetSpecificRetroProfileAllowed": true,
    "valuesOwnedByStudioPreset": true
  },
  "selectiveMaterialEffects": {
    "authoritativeSource": ["material_id", "object_id", "mask_pass", "aov", "authored_metadata"],
    "colorHeuristic": "fallback_debug_only",
    "mustNotLeakAcrossMaterials": true
  },
  "pivot": {
    "source": "projected world origin (0,0,0)",
    "mustBeIdenticalAcrossDirections": true,
    "alphaBoundsDoNotDefinePivot": true
  },
  "footprint": {
    "gridContract": "CH_GRID_V1",
    "tileWidth": 128,
    "tileHeight": 64,
    "manifestRequired": true,
    "rotateOccupiedMaskForNonSquareAssets": true
  },
  "goldenRegression": {
    "assetId": "park_kiosk_1x1",
    "directions": ["south", "east", "west", "north"],
    "meanAbsoluteDifferenceTolerance": 6.0,
    "humanReviewStillRequiredForNewAssets": true,
    "referenceFingerprint": "tools/tycoon_photo_studio/golden/park_kiosk_1x1_golden.json"
  },
  "outputs": {
    "directionFiles": [
      "<asset>_south.png",
      "<asset>_east.png",
      "<asset>_west.png",
      "<asset>_north.png"
    ],
    "fixedFourViewSheet": "<asset>_4view.png",
    "trimmedAtlas": "<asset>_atlas.png",
    "manifest": "<asset>_manifest.json",
    "review": "<asset>_review.png",
    "styleMatrix": "<asset>_style_matrix.png",
    "context": "<asset>_4dir_context.png"
  },
  "reuse": {
    "keep": [
      "CH_CAMERA_V1",
      "CH_GRID_V1",
      "BuildingExportPipeline direction naming/order",
      "Building Composer footprint concepts",
      "pivot/anchor metadata",
      "PNG + JSON export conventions",
      "Animation Core for future directions x frames",
      "Asset Browser/manifests/validation gates"
    ],
    "replaceAsFinalArtAuthority": [
      "simple QPainter procedural shapes used as production visuals",
      "strict retro post-process as mandatory global production authority"
    ]
  },
  "nextGate": "Bake visually different static assets through the unchanged camera/light studio and verify cross-asset coherence at gameplay scale without requiring strict early-2000s pixel-era emulation."
}
