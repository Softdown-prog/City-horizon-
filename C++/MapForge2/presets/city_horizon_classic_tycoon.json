{
  "id": "city_horizon_classic_tycoon",
  "name": "City Horizon Classic Tycoon",
  "revision": "classic_tycoon_19",
  "status": "official",
  "purpose": "Canonical visual baseline for all newly authored City Horizon buildings.",
  "targetPlatform": "windows_pc",
  "projection": {
    "type": "isometric_2_to_1",
    "orthographic": true,
    "rotationDegrees": 45.0,
    "inclinationDegrees": 35.264
  },
  "materials": {
    "recipeVersion": "structured_directional_materials_1",
    "contractFile": "structured_directional_materials_contract.json",
    "wallDefault": "plaster",
    "roofDefault": "ceramic_tile",
    "supportedWallRecipes": ["plaster", "brick", "concrete", "timber", "stone", "metal_panel", "glass", "solid"],
    "supportedRoofRecipes": ["ceramic_tile", "metal_seam", "asphalt_shingle", "solid"],
    "strength": 0.45,
    "scale": 1.0,
    "variation": 0.35,
    "contrast": 0.45,
    "seed": 17,
    "deterministic": true,
    "geometryMutation": false,
    "palette": {
      "wall": "#d8c3a5",
      "roof": "#a94e3f",
      "trim": "#f2eadf",
      "glass": "#78b9d1",
      "door": "#6d4c41",
      "accent": "#d79b38"
    }
  },
  "architecturalModules": {
    "library": "architectural_modules_2",
    "stableIds": true,
    "defaults": {
      "window": "window.classic_framed.v1",
      "door": "door.classic_wood.v1",
      "awning": "awning.canvas_canopy.v1",
      "sign": "sign.facade_plaque.v1",
      "chimney": "chimney.masonry_cap.v1"
    },
    "expandedFacadeModules": [
      "storefront.classic_glass.v1",
      "door.double_glass.v1",
      "garage.rollup_panel.v1",
      "balcony.classic_rail.v1",
      "marquee.flat_canopy.v1",
      "hvac.wall_unit.v1",
      "planter.facade_box.v1"
    ]
  },
  "buildingTypologyPresets": {
    "version": "building_typology_presets_1",
    "libraryFile": "building_typology_presets.json",
    "editableAfterApply": true,
    "recordsOriginInManifest": true,
    "automaticExportStemIncludesTypologyId": true,
    "supported": [
      "small_house",
      "suburban_house",
      "cafeteria",
      "corner_shop",
      "market",
      "warehouse",
      "small_town_hall",
      "school",
      "low_rise_residential",
      "low_rise_office"
    ]
  },
  "flexibleFootprint": {
    "version": "flexible_footprint_1",
    "contractFile": "flexible_footprint_contract.json",
    "supportedShapes": ["rectangle", "l_shape", "courtyard", "annex"],
    "customEnvelopeRangeTiles": [1, 8],
    "recordsOccupiedCellMask": true,
    "recordsSetbacks": true,
    "roadSocketMustTouchOccupiedEdgeCell": true,
    "previewShowsOccupiedCells": true,
    "invalidMaskBlocksProductionExport": true,
    "runtimePlacementUsesOccupiedCells": true
  },
  "proceduralVariation": {
    "version": "controlled_procedural_variation_1",
    "contractFile": "procedural_variation_contract.json",
    "enabledByDefault": false,
    "defaultSeed": 101,
    "defaultStrength": 0.35,
    "deterministic": true,
    "channels": ["palette", "materials", "roof", "facade_modules"],
    "preservesFootprint": true,
    "preservesFloorCount": true,
    "preservesRoadSocket": true,
    "preservesRequiredGroundAccess": true,
    "typologyConstrained": true,
    "sameSeedReproducesSameVariant": true,
    "variantMustPassNormalExportValidation": true
  },
  "floorSystem": {
    "version": "floor_system_1",
    "minimumFloors": 1,
    "maximumFloors": 8,
    "defaultFloors": 1,
    "defaultFloorHeightPx": 82,
    "floorHeightRangePx": [36, 132],
    "floorBandsEnabledByDefault": true,
    "totalWallHeightDerivedFromFloors": true,
    "roofAnchorsToTopFloor": true,
    "singleParametricDefinitionForAllViews": true
  },
  "facadeEditor": {
    "version": "facade_editor_2",
    "moduleLibrary": "architectural_modules_2",
    "manualModeOptional": true,
    "supportedFacades": ["south", "east", "north", "west"],
    "supportedModules": [
      "window", "door", "storefront", "sign", "awning", "double_door",
      "garage_door", "balcony", "marquee", "hvac", "planter"
    ],
    "placementCoordinates": {
      "facadePosition": "normalized_0_to_1",
      "moduleWidth": "normalized_facade_fraction",
      "floor": "zero_based_in_manifest_one_based_in_ui"
    },
    "stableModuleIdsInManifest": true,
    "editableWithoutCode": true,
    "modulesRotateWithBuilding": true,
    "legacyAutomaticFacadeAvailableWhenDisabled": true
  },
  "roofEditor": {
    "version": "roof_editor_1",
    "supportedProfiles": ["gable", "hip", "pyramid", "flat", "shed", "mansard"],
    "defaultProfile": "gable",
    "pitchDegrees": 35.0,
    "pitchRangeDegrees": [12.0, 60.0],
    "overhang": 0.10,
    "overhangRange": [0.0, 0.24],
    "fasciaEnabled": true,
    "fasciaThicknessPx": 2.8,
    "ridgeEnabled": true,
    "ridgeScale": 1.0,
    "chimneyUsesArchitecturalModule": "chimney.masonry_cap.v1",
    "singleParametricDefinitionForAllViews": true
  },
  "streetIntegration": {
    "version": "sidewalk_road_socket_1",
    "contractFile": "street_integration_contract.json",
    "sidewalk": {
      "enabledByDefault": true,
      "integratedWithLot": true,
      "touchesFootprint": true,
      "depthTiles": 0.30,
      "lateralMarginTiles": 0.55,
      "surfaceFamily": "concrete_01",
      "exportedIntoBuildingSprite": false
    },
    "roadSocket": {
      "enabledByDefault": true,
      "defaultEdge": "south",
      "defaultType": "local_street",
      "supportedTypes": ["local_street", "avenue", "service_road"],
      "position": 0.50,
      "widthTiles": 0.36,
      "requiresRoadAdjacency": true,
      "rotatesWithBuilding": true
    },
    "placementRule": "sidewalk_bridges_occupied_building_frontage_to_matching_road_socket"
  },
  "urbanIntegrationValidation": {
    "version": "urban_integration_validation_2",
    "blocksProductionExport": true,
    "checks": [
      "valid_flexible_footprint_mask",
      "sidewalk_connects_to_occupied_footprint",
      "road_socket_fits_authored_facade",
      "road_socket_overlaps_occupied_edge_cell",
      "ground_floor_access_matches_socket_facade",
      "access_aligns_with_socket_through_sidewalk",
      "facade_modules_stay_inside_legal_bounds",
      "ground_floor_projection_stays_clear_of_roadway",
      "roof_overhang_stays_inside_visual_outset_allowance"
    ],
    "accessAlignmentToleranceNormalized": 0.12,
    "groundProjectionAllowance": "sidewalk_depth_tiles + 0.08",
    "maximumRoofOverhangTiles": 0.24,
    "runtimeStillValidatesActualRoadPresence": true
  },
  "environmentPreview": {
    "version": "environment_preview_1",
    "enabledByDefault": true,
    "previewOnly": true,
    "exportedIntoBuildingSprite": false,
    "terrain": "grass_reference",
    "sidewalk": "uses_street_integration_contract",
    "road": "uses_road_socket_contract",
    "footprintMaskOverlay": "uses_flexible_footprint_1",
    "sidewalkTouchesFootprint": true
  },
  "smallBlockPreview": {
    "version": "small_block_preview_1",
    "contractFile": "small_block_preview_contract.json",
    "previewOnly": true,
    "exportedIntoBuildingSprite": false,
    "focusBuildingCount": 1,
    "deterministicNeighbourCount": 5,
    "defaultNeighborhoodSeed": 401,
    "includesRoads": true,
    "includesSidewalks": true,
    "includesTrees": true,
    "includesIntersection": true,
    "focusLotHighlighted": true,
    "reviewPurpose": [
      "gameplay_scale_readability",
      "visual_repetition",
      "silhouette_against_neighbours",
      "street_grounding",
      "density_and_prop_scale"
    ],
    "automaticExportQaFile": "*_block_preview.png"
  },
  "lodVisualGate": {
    "version": "building_lod_gate_1",
    "contractFile": "building_lod_contract.json",
    "blocksProductionExport": true,
    "sourceView": "south",
    "scales": {
      "distant": 0.35,
      "medium": 0.60,
      "close": 1.00
    },
    "metrics": [
      "alpha_silhouette_bounds",
      "visible_alpha_pixel_area",
      "opaque_luminance_range"
    ],
    "automaticExportQaFile": "*_lod_preview.png",
    "qaPreviewOnly": true,
    "mutatesProductionSprite": false
  },
  "assetBrowser": {
    "version": "building_asset_browser_1",
    "contractFile": "building_asset_browser_contract.json",
    "entryPoint": "Asset Browser / Library…",
    "manifestGlob": "*_manifest.json",
    "recursiveScan": true,
    "filters": ["text", "typology", "footprint", "floors", "status"],
    "thumbnailFromExportPackage": true,
    "reopenNode": "authoringSpec",
    "authoringSnapshotVersion": "building_authoring_spec_1",
    "newPackagesReopenable": true,
    "legacyPackagesBrowseOnly": true,
    "realizedProceduralVariantsOpenAsFixedEditableAssets": true,
    "reexportUsesNormalValidationGate": true
  },
  "automaticExport": {
    "version": "automatic_export_validation_7",
    "enabled": true,
    "deterministicNaming": true,
    "automaticFrameByFootprintEnvelope": true,
    "automaticFrameIncludesFloorHeight": true,
    "automaticStemIncludesTypologyId": true,
    "automaticStemIncludesFootprintShape": true,
    "automaticStemIncludesVariationSeedWhenApplied": true,
    "frameIncrementPx": 32,
    "minimumFrame": [320, 280],
    "package": [
      "south_rgba_png", "east_rgba_png", "west_rgba_png", "north_rgba_png",
      "four_view_sheet", "review_sheet", "small_block_qa_preview", "lod_qa_preview",
      "thumbnail", "manifest_json", "validation_json"
    ],
    "validationGate": {
      "blocksInvalidProductionExport": true,
      "checks": [
        "flexible_footprint_1",
        "floor_count_range",
        "frame_fit_for_footprint_floors_and_roof",
        "ground_anchor_contact",
        "sprite_edge_clipping",
        "transparent_rgb_contamination",
        "extreme_low_alpha_white_or_black_halo",
        "urban_integration_validation_2",
        "building_lod_gate_1"
      ],
      "proceduralVariantsUseSameGate": true,
      "haloSuspicionTolerancePixels": 12,
      "validationReportWrittenOnFailure": true
    },
    "recordsReopenableAuthoringSpec": true,
    "authoringSpecNode": "authoringSpec",
    "authoringSnapshotVersion": "building_authoring_spec_1",
    "assetBrowserContract": "building_asset_browser_contract.json",
    "smallBlockQaPreviewGeneratedAfterValidation": true,
    "lodQaPreviewGeneratedAfterValidation": true,
    "transparentBuildingOnly": true,
    "environmentContextExportedIntoProductionSprite": false
  },
  "lighting": {
    "version": "classic_three_tone_ramp_1",
    "contractFile": "classic_three_tone_ramp_contract.json",
    "continuousWallGradient": false,
    "cameraIndependent": true,
    "wallLightScale": 1.075,
    "wallMidScale": 0.965,
    "wallShadowScale": 0.735,
    "wallWorldAssignment": {
      "west": "light",
      "north": "mid",
      "south": "mid",
      "east": "shadow"
    },
    "wallLightWarmTint": "#f7e7c9",
    "wallShadowCoolTint": "#64758a",
    "roofShadowFaceFactor": 0.86,
    "roofLitFaceFactor": 1.06
  },
  "castShadow": {
    "version": "fixed_world_cast_shadow_1",
    "contractFile": "fixed_world_cast_shadow_contract.json",
    "enabled": true,
    "worldDirection": [1.0, 0.35],
    "heightLengthScale": 0.27,
    "minimumLengthPx": 14.0,
    "maximumLengthPx": 34.0,
    "coreAlpha": 46,
    "nearFieldAlpha": 12,
    "penumbraAlpha": 18,
    "penumbraExtension": 1.08,
    "frameSafetyMarginPx": 4.0,
    "cameraIndependent": true,
    "gaussianBlur": false,
    "legacyProductionShadowDisabled": true
  },
  "ambientOcclusion": {
    "version": "localized_contact_ao_1",
    "contractFile": "localized_contact_ao_contract.json",
    "eaveDepthPx": 3.4,
    "eaveAlphaBands": [30, 16, 7],
    "cornerNormalizedSpan": 0.036,
    "cornerAlphaBands": [20, 9, 4],
    "wallGroundContactAlpha": 78,
    "recessContactEnabled": true,
    "recessAlphaRange": [62, 72],
    "broadWallWash": false,
    "paintedVerticalStripe": false,
    "roofWallContactHandledByEaveAo": true
  },
  "outlines": {
    "structuralWidth": 1.20,
    "contactWidth": 1.20,
    "roofEdgeWidth": 1.35,
    "structuralColor": "#2d3133dc"
  },
  "roofFinish": {
    "defaultStyle": "gable",
    "defaultHeightPx": 34,
    "nonFlatOverhang": 0.10,
    "flatOverhang": 0.04,
    "eaveThicknessPx": 2.8,
    "ridgeLayeredCap": true,
    "gableRakeTrim": true,
    "pyramidHipJoint": true,
    "dripEdge": true
  },
  "base": {
    "structuralPlinth": true,
    "plinthHeightWallRatio": 0.075,
    "plinthHeightMinPx": 5.0,
    "plinthHeightMaxPx": 9.0,
    "plinthOutset": 1.018,
    "projectingCapOutset": 1.026
  },
  "windows": {
    "enabled": true,
    "defaultPattern": "pair",
    "recessed": true,
    "innerAo": true,
    "projectingHead": true,
    "jambReturns": true,
    "twoStepSill": true,
    "dripEdge": true
  },
  "door": {
    "enabled": true,
    "defaultPosition": "center",
    "recessed": true,
    "innerAo": true,
    "projectingHeader": true,
    "jambSurround": true,
    "twoLevelThreshold": true
  },
  "authoringRule": "Every accepted City Horizon building remains subject to the footprint, halo, urban-integration and LOD production gates. The production wall raster uses classic_three_tone_ramp_1 over structured_directional_materials_1. The global cast shadow uses fixed_world_cast_shadow_1: one camera-independent world direction, height-derived bounded reach, cool-charcoal core and compact anti-aliased penumbra, composited before the building. The legacy camera-relative shadow is disabled in the production facade path. Ambient occlusion uses localized_contact_ao_1 only at real contacts. automatic_export_validation_7 records building_authoring_spec_1 so validated packages can be indexed by building_asset_browser_1, reopened in the Building Composer, edited and re-exported through the same gates."
}
