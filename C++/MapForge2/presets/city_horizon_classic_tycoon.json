{
  "id": "city_horizon_classic_tycoon",
  "name": "City Horizon Classic Tycoon",
  "revision": "classic_tycoon_9",
  "status": "official",
  "purpose": "Canonical visual baseline for all newly authored City Horizon buildings.",
  "targetPlatform": "windows_pc",
  "projection": {
    "type": "isometric_2_to_1",
    "orthographic": true,
    "rotationDegrees": 45.0,
    "inclinationDegrees": 35.264
  },
  "materials": {
    "recipeVersion": "rich_materials_1",
    "wallDefault": "plaster",
    "roofDefault": "ceramic_tile",
    "supportedWallRecipes": ["plaster", "brick", "concrete", "timber", "stone", "metal_panel", "glass", "solid"],
    "supportedRoofRecipes": ["ceramic_tile", "metal_seam", "asphalt_shingle", "solid"],
    "strength": 0.45,
    "scale": 1.0,
    "variation": 0.35,
    "contrast": 0.45,
    "seed": 17,
    "deterministic": true,
    "geometryMutation": false,
    "palette": {
      "wall": "#d8c3a5",
      "roof": "#a94e3f",
      "trim": "#f2eadf",
      "glass": "#78b9d1",
      "door": "#6d4c41",
      "accent": "#d79b38"
    }
  },
  "architecturalModules": {
    "library": "architectural_modules_2",
    "stableIds": true,
    "defaults": {
      "window": "window.classic_framed.v1",
      "door": "door.classic_wood.v1",
      "awning": "awning.canvas_canopy.v1",
      "sign": "sign.facade_plaque.v1",
      "chimney": "chimney.masonry_cap.v1"
    },
    "expandedFacadeModules": [
      "storefront.classic_glass.v1",
      "door.double_glass.v1",
      "garage.rollup_panel.v1",
      "balcony.classic_rail.v1",
      "marquee.flat_canopy.v1",
      "hvac.wall_unit.v1",
      "planter.facade_box.v1"
    ]
  },
  "floorSystem": {
    "version": "floor_system_1",
    "minimumFloors": 1,
    "maximumFloors": 8,
    "defaultFloors": 1,
    "defaultFloorHeightPx": 82,
    "floorHeightRangePx": [36, 132],
    "floorBandsEnabledByDefault": true,
    "totalWallHeightDerivedFromFloors": true,
    "roofAnchorsToTopFloor": true,
    "singleParametricDefinitionForAllViews": true
  },
  "facadeEditor": {
    "version": "facade_editor_2",
    "moduleLibrary": "architectural_modules_2",
    "manualModeOptional": true,
    "supportedFacades": ["south", "east", "north", "west"],
    "supportedModules": [
      "window",
      "door",
      "storefront",
      "sign",
      "awning",
      "double_door",
      "garage_door",
      "balcony",
      "marquee",
      "hvac",
      "planter"
    ],
    "placementCoordinates": {
      "facadePosition": "normalized_0_to_1",
      "moduleWidth": "normalized_facade_fraction",
      "floor": "zero_based_in_manifest_one_based_in_ui"
    },
    "stableModuleIdsInManifest": true,
    "editableWithoutCode": true,
    "modulesRotateWithBuilding": true,
    "legacyAutomaticFacadeAvailableWhenDisabled": true
  },
  "roofEditor": {
    "version": "roof_editor_1",
    "supportedProfiles": ["gable", "hip", "pyramid", "flat", "shed", "mansard"],
    "defaultProfile": "gable",
    "pitchDegrees": 35.0,
    "pitchRangeDegrees": [12.0, 60.0],
    "overhang": 0.10,
    "overhangRange": [0.0, 0.24],
    "fasciaEnabled": true,
    "fasciaThicknessPx": 2.8,
    "ridgeEnabled": true,
    "ridgeScale": 1.0,
    "chimneyUsesArchitecturalModule": "chimney.masonry_cap.v1",
    "singleParametricDefinitionForAllViews": true
  },
  "streetIntegration": {
    "version": "sidewalk_road_socket_1",
    "sidewalk": {
      "enabledByDefault": true,
      "integratedWithLot": true,
      "touchesFootprint": true,
      "depthTiles": 0.30,
      "lateralMarginTiles": 0.55,
      "surfaceFamily": "concrete_01",
      "exportedIntoBuildingSprite": false
    },
    "roadSocket": {
      "enabledByDefault": true,
      "defaultEdge": "south",
      "defaultType": "local_street",
      "supportedTypes": ["local_street", "avenue", "service_road"],
      "position": 0.50,
      "widthTiles": 0.36,
      "requiresRoadAdjacency": true,
      "rotatesWithBuilding": true
    },
    "placementRule": "sidewalk_bridges_building_footprint_to_matching_road_socket"
  },
  "environmentPreview": {
    "version": "environment_preview_1",
    "enabledByDefault": true,
    "previewOnly": true,
    "exportedIntoBuildingSprite": false,
    "terrain": "grass_reference",
    "sidewalk": "uses_street_integration_contract",
    "road": "uses_road_socket_contract",
    "sidewalkTouchesFootprint": true
  },
  "automaticExport": {
    "version": "automatic_export_validation_1",
    "enabled": true,
    "deterministicNaming": true,
    "automaticFrameByFootprint": true,
    "automaticFrameIncludesFloorHeight": true,
    "frameIncrementPx": 32,
    "minimumFrame": [320, 280],
    "package": ["south_rgba_png", "east_rgba_png", "west_rgba_png", "north_rgba_png", "four_view_sheet", "review_sheet", "thumbnail", "manifest_json", "validation_json"],
    "validationGate": {
      "blocksInvalidProductionExport": true,
      "checks": ["declared_footprint_range", "floor_count_range", "frame_fit_for_footprint_floors_and_roof", "ground_anchor_contact", "sprite_edge_clipping", "transparent_rgb_contamination", "extreme_low_alpha_white_or_black_halo"],
      "haloSuspicionTolerancePixels": 12,
      "validationReportWrittenOnFailure": true
    },
    "transparentBuildingOnly": true,
    "environmentContextExported": false
  },
  "lighting": {
    "wallShadowFaceFactor": 0.84,
    "wallLitFaceFactor": 1.0,
    "wallGradientTopFactor": 1.045,
    "wallGradientBottomFactor": 0.94,
    "roofShadowFaceFactor": 0.86,
    "roofLitFaceFactor": 1.06,
    "castShadowEnabled": true,
    "contactShadowAlpha": 58,
    "castShadowAlpha": 46
  },
  "ambientOcclusion": {
    "eaveDepthPx": 6.0,
    "eaveAlphaBands": [42, 30, 20, 12, 6],
    "cornerWorldSpan": 0.075,
    "cornerAlphaBands": [30, 20, 12, 5],
    "wallGroundContactAlpha": 115,
    "roofWallContactAlpha": 135
  },
  "outlines": {
    "structuralWidth": 1.20,
    "contactWidth": 1.20,
    "roofEdgeWidth": 1.35,
    "structuralColor": "#2d3133dc"
  },
  "roofFinish": {
    "defaultStyle": "gable",
    "defaultHeightPx": 34,
    "nonFlatOverhang": 0.10,
    "flatOverhang": 0.04,
    "eaveThicknessPx": 2.8,
    "ridgeLayeredCap": true,
    "gableRakeTrim": true,
    "pyramidHipJoint": true,
    "dripEdge": true
  },
  "base": {
    "structuralPlinth": true,
    "plinthHeightWallRatio": 0.075,
    "plinthHeightMinPx": 5.0,
    "plinthHeightMaxPx": 9.0,
    "plinthOutset": 1.018,
    "projectingCapOutset": 1.026
  },
  "windows": {
    "enabled": true,
    "defaultPattern": "pair",
    "recessed": true,
    "innerAo": true,
    "projectingHead": true,
    "jambReturns": true,
    "twoStepSill": true,
    "dripEdge": true
  },
  "door": {
    "enabled": true,
    "defaultPosition": "center",
    "recessed": true,
    "innerAo": true,
    "projectingHeader": true,
    "jambSurround": true,
    "twoLevelThreshold": true
  },
  "authoringRule": "Buildings may use 1–8 floors and architectural_modules_2 placements on any logical facade. Every reusable facade component must keep a stable module ID, floor index and normalized facade placement instead of custom per-view drawing. All four views derive from one building definition; roofs anchor to the computed top floor; road sockets rotate with the building; preview environment stays out of production PNGs; validated export remains mandatory."
}
