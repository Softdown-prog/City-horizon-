{
  "id": "city_horizon_classic_tycoon",
  "name": "City Horizon Classic Tycoon",
  "revision": "classic_tycoon_6",
  "status": "official",
  "purpose": "Canonical visual baseline for all newly authored City Horizon buildings.",
  "targetPlatform": "windows_pc",
  "projection": {
    "type": "isometric_2_to_1",
    "orthographic": true,
    "rotationDegrees": 45.0,
    "inclinationDegrees": 35.264
  },
  "materials": {
    "recipeVersion": "rich_materials_1",
    "wallDefault": "plaster",
    "roofDefault": "ceramic_tile",
    "supportedWallRecipes": [
      "plaster",
      "brick",
      "concrete",
      "timber",
      "stone",
      "metal_panel",
      "glass",
      "solid"
    ],
    "supportedRoofRecipes": [
      "ceramic_tile",
      "metal_seam",
      "asphalt_shingle",
      "solid"
    ],
    "strength": 0.45,
    "scale": 1.0,
    "variation": 0.35,
    "contrast": 0.45,
    "seed": 17,
    "deterministic": true,
    "geometryMutation": false,
    "palette": {
      "wall": "#d8c3a5",
      "roof": "#a94e3f",
      "trim": "#f2eadf",
      "glass": "#78b9d1",
      "door": "#6d4c41",
      "accent": "#d79b38"
    }
  },
  "architecturalModules": {
    "library": "architectural_modules_1",
    "stableIds": true,
    "defaults": {
      "window": "window.classic_framed.v1",
      "door": "door.classic_wood.v1",
      "awning": "awning.canvas_canopy.v1",
      "sign": "sign.facade_plaque.v1",
      "chimney": "chimney.masonry_cap.v1"
    }
  },
  "roofEditor": {
    "version": "roof_editor_1",
    "supportedProfiles": [
      "gable",
      "hip",
      "pyramid",
      "flat",
      "shed",
      "mansard"
    ],
    "defaultProfile": "gable",
    "pitchDegrees": 35.0,
    "pitchRangeDegrees": [12.0, 60.0],
    "overhang": 0.10,
    "overhangRange": [0.0, 0.24],
    "fasciaEnabled": true,
    "fasciaThicknessPx": 2.8,
    "ridgeEnabled": true,
    "ridgeScale": 1.0,
    "chimneyUsesArchitecturalModule": "chimney.masonry_cap.v1",
    "singleParametricDefinitionForAllViews": true
  },
  "streetIntegration": {
    "version": "sidewalk_road_socket_1",
    "sidewalk": {
      "enabledByDefault": true,
      "integratedWithLot": true,
      "touchesFootprint": true,
      "depthTiles": 0.30,
      "lateralMarginTiles": 0.55,
      "surfaceFamily": "concrete_01",
      "exportedIntoBuildingSprite": false
    },
    "roadSocket": {
      "enabledByDefault": true,
      "defaultEdge": "south",
      "defaultType": "local_street",
      "supportedTypes": [
        "local_street",
        "avenue",
        "service_road"
      ],
      "position": 0.50,
      "widthTiles": 0.36,
      "requiresRoadAdjacency": true,
      "rotatesWithBuilding": true
    },
    "placementRule": "sidewalk_bridges_building_footprint_to_matching_road_socket",
    "purpose": "Give every authored building an explicit, rotation-safe street frontage contract so placement can reject lots without matching road access and avoid accidental grass gaps."
  },
  "environmentPreview": {
    "version": "environment_preview_1",
    "enabledByDefault": true,
    "previewOnly": true,
    "exportedIntoBuildingSprite": false,
    "terrain": "grass_reference",
    "sidewalk": "uses_street_integration_contract",
    "road": "uses_road_socket_contract",
    "sidewalkTouchesFootprint": true,
    "purpose": "Validate gameplay-scale grounding, street access and accidental grass gaps before asset export."
  },
  "lighting": {
    "wallShadowFaceFactor": 0.84,
    "wallLitFaceFactor": 1.0,
    "wallGradientTopFactor": 1.045,
    "wallGradientBottomFactor": 0.94,
    "roofShadowFaceFactor": 0.86,
    "roofLitFaceFactor": 1.06,
    "castShadowEnabled": true,
    "contactShadowAlpha": 58,
    "castShadowAlpha": 46
  },
  "ambientOcclusion": {
    "eaveDepthPx": 6.0,
    "eaveAlphaBands": [42, 30, 20, 12, 6],
    "cornerWorldSpan": 0.075,
    "cornerAlphaBands": [30, 20, 12, 5],
    "wallGroundContactAlpha": 115,
    "roofWallContactAlpha": 135
  },
  "outlines": {
    "structuralWidth": 1.20,
    "contactWidth": 1.20,
    "roofEdgeWidth": 1.35,
    "structuralColor": "#2d3133dc"
  },
  "roofFinish": {
    "defaultStyle": "gable",
    "defaultHeightPx": 34,
    "nonFlatOverhang": 0.10,
    "flatOverhang": 0.04,
    "eaveThicknessPx": 2.8,
    "ridgeLayeredCap": true,
    "gableRakeTrim": true,
    "pyramidHipJoint": true,
    "dripEdge": true
  },
  "base": {
    "structuralPlinth": true,
    "plinthHeightWallRatio": 0.075,
    "plinthHeightMinPx": 5.0,
    "plinthHeightMaxPx": 9.0,
    "plinthOutset": 1.018,
    "projectingCapOutset": 1.026
  },
  "windows": {
    "enabled": true,
    "defaultPattern": "pair",
    "recessed": true,
    "innerAo": true,
    "projectingHead": true,
    "jambReturns": true,
    "twoStepSill": true,
    "dripEdge": true
  },
  "door": {
    "enabled": true,
    "defaultPosition": "center",
    "recessed": true,
    "innerAo": true,
    "projectingHeader": true,
    "jambSurround": true,
    "twoLevelThreshold": true
  },
  "authoringRule": "Architectural presets and per-building options may vary geometry, module placement, palette, material choice, roof profile and street frontage, but reusable architectural components must reference the canonical module library, every roof view must derive from the same parametric roof definition, the road socket must rotate with the building, the integrated sidewalk must touch the footprint without a grass gap, and environment context must remain preview-only so exported building PNGs stay clean and transparent."
}
