{
  "id": "automatic_export_validation_6",
  "name": "Building Composer Automatic Export + Validation",
  "targetPlatform": "windows_pc",
  "gridContract": "CH_GRID_V1",
  "tile": {
    "width": 128,
    "height": 64,
    "projection": "isometric_2_to_1"
  },
  "framePolicy": {
    "automaticByFootprintEnvelope": true,
    "minimumWidth": 320,
    "minimumHeight": 280,
    "roundToIncrementPx": 32,
    "accountsFor": [
      "footprint_envelope_width",
      "footprint_envelope_depth",
      "floor_count",
      "floor_height",
      "roof_height",
      "roof_pitch",
      "roof_overhang"
    ]
  },
  "validation": {
    "blocking": true,
    "footprintEnvelopeRangeTiles": {
      "minimum": 1,
      "maximum": 8
    },
    "checks": [
      "flexible_footprint_1",
      "recommended_frame_fit",
      "ground_anchor_contact",
      "outer_frame_clipping",
      "fully_transparent_rgb_contamination",
      "extreme_low_alpha_white_or_black_fringe",
      "urban_integration_validation_2",
      "building_lod_gate_1"
    ],
    "proceduralVariation": {
      "contract": "procedural_variation_contract.json",
      "usesSameValidationGateAsAuthoredBase": true,
      "recordsSeedAndStrength": true,
      "recordsAllowedChannels": true,
      "mustPreservePlacementCompatibility": true
    },
    "flexibleFootprint": {
      "contract": "flexible_footprint_contract.json",
      "blocksExport": true,
      "recordsOccupiedCells": true,
      "requiresNonEmptyMask": true,
      "validatesShapeMinimumEnvelope": true,
      "validatesSetbackRange": true
    },
    "urbanIntegration": {
      "contract": "street_integration_contract.json",
      "blocksExport": true,
      "checksSidewalkFootprintContact": true,
      "checksRoadSocketBounds": true,
      "checksRoadSocketOccupiedFrontage": true,
      "checksGroundAccessAlignment": true,
      "checksFacadeModuleBounds": true,
      "checksRoadwayProjectionClearance": true,
      "checksRoofVisualOutset": true,
      "actualRoadPresenceIsRuntimePlacementResponsibility": true
    },
    "lodVisualGate": {
      "contract": "building_lod_contract.json",
      "blocksExport": true,
      "scales": [0.35, 0.60, 1.00],
      "metrics": ["alpha_silhouette_bounds", "visible_alpha_pixel_area", "opaque_luminance_range"],
      "qaImage": "<stem>_lod_preview.png"
    },
    "halo": {
      "lowAlphaMaximum": 32,
      "opaqueNeighbourMinimum": 96,
      "channelDeltaThreshold": 92,
      "suspiciousPixelTolerance": 12
    },
    "failureBehavior": {
      "writeValidationJson": true,
      "writeProductionPngs": false,
      "writeProductionManifest": false
    }
  },
  "package": {
    "deterministicStemBase": "building_<typology>_<footprint_shape>_<width>x<depth>_<floors>f_<roof_profile>_seed<material_seed>",
    "proceduralVariantSuffix": "_v<variation_seed>",
    "outputs": [
      "<stem>_south.png",
      "<stem>_east.png",
      "<stem>_west.png",
      "<stem>_north.png",
      "<stem>_4view.png",
      "<stem>_review.png",
      "<stem>_block_preview.png",
      "<stem>_lod_preview.png",
      "<stem>_thumb.png",
      "<stem>_manifest.json",
      "<stem>_validation.json"
    ],
    "manifest": {
      "footprintNode": "geometry.flexibleFootprint",
      "proceduralVariationNode": "proceduralVariation",
      "smallBlockPreviewNode": "smallBlockPreview",
      "lodVisualGateNode": "lodVisualGate",
      "recordsOccupiedCellMask": true,
      "recordsSetbacks": true,
      "recordsVariationSeed": true,
      "recordsQaPreviewContract": true,
      "recordsLodMetrics": true
    },
    "qaPreview": {
      "smallBlockContract": "small_block_preview_contract.json",
      "smallBlockFileSuffix": "_block_preview.png",
      "lodContract": "building_lod_contract.json",
      "lodFileSuffix": "_lod_preview.png",
      "includedInProductionSprite": false
    },
    "png": {
      "rgba": true,
      "transparentBackground": true,
      "environmentPreviewIncludedInProductionSprite": false,
      "footprintMaskOverlayIncluded": false,
      "lodPreviewIncludedInProductionSprite": false
    }
  },
  "rule": "A production building package is accepted only after flexible footprint, frame, anchor, halo, urban-integration and gameplay-scale LOD gates pass. Every accepted package receives small-block and distant/medium/close LOD QA previews; neither QA image is baked into the transparent production sprites."
}
